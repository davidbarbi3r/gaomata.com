  "description": "Site officiel de Gao Mata : Fly Yoga, souplesse et sophrologie à Boisseuil et Limoges.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
