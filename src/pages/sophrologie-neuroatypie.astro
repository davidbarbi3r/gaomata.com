---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import Lines from '../components/Lines.astro';
import PageHero from '../components/PageHero.astro';
import PricingList from '../components/PricingList.astro';
import sophroHero from '../assets/images/sophro.jpeg';
import portrait from '../assets/images/marion-portrait.jpeg';
import { toParagraphs } from '../cms/format';
import { getContent } from '../cms/load';
import { breadcrumbSchema, serviceSchema } from '../data/seo';
import { SITE } from '../data/site';

const content = await getContent();
const {
  seo,
  hero,
  definition,
  raisons,
  deroule,
  neuro,
  tarifs,
  prestations,
  rendezVous,
  faq,
} = content.sophro;
const { contact, lieux } = content.commun;
const schemas = [
  serviceSchema(
    'Sophrologie et accompagnement de la neuroatypie',
    seo.description,
    '/sophrologie-neuroatypie',
    'Séances de sophrologie',
  ),
  breadcrumbSchema([
    { name: 'Accueil', path: '/' },
    { name: 'Sophrologie et Neuroatypie', path: '/sophrologie-neuroatypie' },
  ]),
];
---

<BaseLayout title={seo.title} description={seo.description} {schemas}>
  <PageHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    intro={hero.intro}
    image={sophroHero}
    alt={hero.imageAlt}
    tone="olive"
  >
    <a class="button button--light" href="#prestations">
      {hero.ctaLabel}
      <span class="button__icon" aria-hidden="true">
        ↗
      </span>
    </a>
  </PageHero>

  <section class="section definition">
    <div class="container definition-grid">
      <div class="definition-title reveal">
        <span class="eyebrow">{definition.eyebrow}</span>
        <h2>{definition.title}</h2>
      </div>
      <div class="definition-copy reveal reveal-delay-1">
        <p class="lead">
          <Lines text={definition.text} />
        </p>
        <blockquote>
          «&nbsp;
          <Lines text={definition.quote} />
          &nbsp;»
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section reasons" aria-labelledby="reasons-title">
    <div class="container reasons-grid">
      <div class="reasons-heading reveal">
        <span class="eyebrow">{raisons.eyebrow}</span>
        <h2 id="reasons-title">{raisons.title}</h2>
      </div>
      <div class="reason-list">
        {raisons.items.map((reason, index) => (
          <div class={`reason reveal reveal-delay-${(index % 3) + 1}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p>{reason.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="container process-grid">
      <div class="process-media reveal">
        <Image
          src={portrait}
          alt={deroule.imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 832px) 100vw, 42vw"
          quality={85}
        />
        <span class="process-label">{deroule.imageLabel}</span>
      </div>
      <div class="process-copy">
        <div class="reveal">
          <span class="eyebrow">{deroule.eyebrow}</span>
          <h2>{deroule.title}</h2>
          <p>
            <Lines text={deroule.text} />
          </p>
        </div>
        <div class="process-steps">
          {deroule.steps.map((step, index) => (
            <article
              class={`reveal${index ? ` reveal-delay-${Math.min(index, 3)}` : ''}`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>
                  <Lines text={step.text} />
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section neuro">
    <div class="container neuro-grid">
      <div class="neuro-heading reveal">
        <span class="eyebrow">{neuro.eyebrow}</span>
        <h2>{neuro.title}</h2>
      </div>
      <div class="neuro-copy reveal reveal-delay-1">
        <p class="lead">
          <Lines text={neuro.text} />
        </p>
        <p class="boundary">
          <Lines text={neuro.boundary} />
        </p>
        <div class="neuro-tags" aria-label="Principes de l’accompagnement">
          {neuro.tags.map((tag) => (
            <span>{tag.text}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section sophro-prices">
    <div class="container price-layout">
      <div class="price-copy reveal">
        <span class="eyebrow">{tarifs.eyebrow}</span>
        <h2>{tarifs.title}</h2>
        <p>
          <Lines text={tarifs.text} />
        </p>
      </div>
      <div class="reveal reveal-delay-1">
        <PricingList
          title={tarifs.listTitle}
          items={tarifs.items}
          note={tarifs.listNote}
        />
      </div>
    </div>
  </section>

  <section class="section sophro-booking" id="prestations">
    <div class="container reveal">
      <BookingEmbed
        id="reservation-sophrologie"
        title={prestations.title}
        description={prestations.description}
        embedUrl={SITE.sophrologyEmbed}
        profileUrl={contact.bookingProfile}
        buttonLabel="Afficher les prestations"
        tone="olive"
        autoLoad
        compact
      />
    </div>
  </section>

  <section class="section appointments">
    <div class="container appointments-grid">
      <div class="appointment-heading reveal">
        <span class="eyebrow">{rendezVous.eyebrow}</span>
        <h2>{rendezVous.title}</h2>
      </div>
      <div class="appointment-list">
        {lieux.items.map((location, index) => (
          <article class={`appointment reveal reveal-delay-${(index % 3) + 1}`}>
            <span>{location.city}</span>
            <h3>{location.name}</h3>
            <p>
              <Lines text={location.detail} />
            </p>
          </article>
        ))}
        <div class="appointment-cta reveal">
          <p>
            <Lines text={rendezVous.ctaText} />
          </p>
          <a class="button button--light" href={`mailto:${contact.email}`}>
            {rendezVous.ctaButton}
            <span class="button__icon" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq">
    <div class="narrow">
      <div class="faq-heading reveal">
        <span class="eyebrow">{faq.eyebrow}</span>
        <h2>{faq.title}</h2>
      </div>
      {faq.items.map((item, index) => (
        <details class="reveal">
          <summary>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item.question}
          </summary>
          {toParagraphs(item.answer).map((paragraph) => (
            <p>
              <Lines text={paragraph} />
            </p>
          ))}
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .definition-grid,
  .reasons-grid,
  .neuro-grid,
  .price-layout,
  .appointments-grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 8vw, 9rem);
    grid-template-columns: 0.9fr 1.1fr;
  }

  .definition-title h2,
  .reasons-heading h2,
  .neuro-heading h2,
  .price-copy h2,
  .appointment-heading h2 {
    max-width: 10ch;
  }

  .definition-copy blockquote {
    margin: 4rem 0 0;
    padding: 2rem 0 0 2rem;
    border-top: 1px solid rgb(75 46 32 / 16%);
    border-left: 0.35rem solid var(--clay);
    color: var(--harbor);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .reasons {
    background: var(--clay);
  }

  .reason-list {
    display: grid;
  }

  .reason {
    display: grid;
    align-items: baseline;
    padding: 1.5rem 0;
    border-top: 1px solid rgb(75 46 32 / 22%);
    gap: 1.5rem;
    grid-template-columns: 2rem 1fr;
  }

  .reason > span {
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 850;
  }

  .reason p {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 560;
    line-height: 1.2;
  }

  .process {
    background: var(--harbor);
    color: var(--white);
  }

  .process-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 0.85fr 1.15fr;
  }

  .process-media {
    position: relative;
    min-height: 42rem;
    overflow: hidden;
    border-radius: 1.15rem;
  }

  .process-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-label {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    left: 1.2rem;
    padding: 0.8rem;
    border-radius: var(--radius-pill);
    background: rgb(30 47 68 / 78%);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .process-copy > div:first-child > p {
    max-width: 38rem;
    color: rgb(255 255 255 / 68%);
  }

  .process-steps {
    display: grid;
    margin-top: 3rem;
  }

  .process-steps article {
    display: grid;
    padding: 1.2rem 0;
    border-top: 1px solid rgb(255 255 255 / 14%);
    gap: 1.5rem;
    grid-template-columns: 2rem 1fr;
  }

  .process-steps article > span {
    color: var(--clay);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .process-steps h3 {
    margin-bottom: 0.35rem;
    font-size: 1.35rem;
  }

  .process-steps p {
    margin: 0;
    color: rgb(255 255 255 / 60%);
    font-size: 0.84rem;
  }

  .neuro {
    background: var(--cream-deep);
  }

  .boundary {
    margin: 2.5rem 0;
    padding: 1.3rem 1.5rem;
    border-left: 0.3rem solid var(--sienna);
    background: rgb(255 255 255 / 35%);
    color: var(--walnut);
    font-size: 0.84rem;
  }

  .neuro-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .neuro-tags span {
    padding: 0.65rem 1rem;
    border: 1px solid rgb(75 46 32 / 17%);
    border-radius: var(--radius-pill);
    color: var(--harbor);
    font-size: 0.7rem;
    font-weight: 750;
  }

  .sophro-prices {
    background: var(--sienna);
    color: var(--white);
  }

  .price-copy {
    position: sticky;
    top: 8rem;
  }

  .price-copy p {
    max-width: 32rem;
    color: var(--white);
  }

  .price-layout > :last-child {
    color: var(--ink);
  }

  .appointments {
    background: var(--olive);
    color: var(--white);
  }

  .sophro-booking {
    background: var(--cream-deep);
  }

  .appointment-list {
    display: grid;
    gap: 0.75rem;
  }

  .appointment {
    padding: clamp(1.5rem, 4vw, 2.8rem);
    border-radius: var(--radius-md);
    background: rgb(30 47 68 / 24%);
  }

  .appointment > span {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.62rem;
    font-weight: 820;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .appointment h3 {
    margin-bottom: 0.7rem;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
  }

  .appointment p {
    margin: 0;
    color: var(--white);
  }

  .appointment-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem;
  }

  .appointment-cta p {
    max-width: 20rem;
    margin: 0;
  }

  .faq-heading {
    margin-bottom: 3rem;
  }

  .faq-heading h2 {
    max-width: 11ch;
  }

  details {
    padding: 1.5rem 0;
    border-top: 1px solid rgb(75 46 32 / 17%);
  }

  details:last-child {
    border-bottom: 1px solid rgb(75 46 32 / 17%);
  }

  summary {
    display: grid;
    align-items: baseline;
    color: var(--harbor);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    font-weight: 580;
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    color: var(--walnut);
    font-family: var(--font-body);
    font-size: 0.6rem;
  }

  details p {
    max-width: 42rem;
    margin: 1rem 0 0 3rem;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .definition-grid,
    .reasons-grid,
    .process-grid,
    .neuro-grid,
    .price-layout,
    .appointments-grid {
      grid-template-columns: 1fr;
    }

    .process-media {
      min-height: 34rem;
    }

    .price-copy {
      position: static;
    }
  }
</style>
