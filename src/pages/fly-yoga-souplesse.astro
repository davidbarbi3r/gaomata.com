---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingEmbed from '../components/BookingEmbed.astro';
import Lines from '../components/Lines.astro';
import PageHero from '../components/PageHero.astro';
import PricingList from '../components/PricingList.astro';
import flyHero from '../assets/images/fly-2.jpeg';
import flyKids from '../assets/images/fly-kids.jpeg';
import flexibility from '../assets/images/souplesse-1.jpeg';
import { toParagraphs } from '../cms/format';
import { getContent } from '../cms/load';
import { breadcrumbSchema, serviceSchema } from '../data/seo';
import { SITE } from '../data/site';

const content = await getContent();
const {
  seo,
  hero,
  pratique,
  formules,
  souplesse,
  cadre,
  tarifs,
  planning,
  faq,
} = content.fly;
const schemas = [
  serviceSchema(
    'Fly Yoga et souplesse',
    seo.description,
    '/fly-yoga-souplesse',
    'Cours de yoga aérien et de souplesse',
  ),
  breadcrumbSchema([
    { name: 'Accueil', path: '/' },
    { name: 'Fly Yoga et Souplesse', path: '/fly-yoga-souplesse' },
  ]),
];
const collectiveItems = tarifs.collectiveItems.map((item) => ({
  label: item.label,
  note: item.note,
  price: item.price2 ? [item.price, item.price2] : item.price,
}));
---

<BaseLayout title={seo.title} description={seo.description} {schemas}>
  <PageHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    intro={hero.intro}
    image={flyHero}
    alt={hero.imageAlt}
    tone="amber"
  >
    <a class="button button--light" href="#planning">
      {hero.ctaLabel}
      <span class="button__icon" aria-hidden="true">
        ↗
      </span>
    </a>
  </PageHero>

  <section class="section fly-intro">
    <div class="container intro-grid">
      <div class="reveal">
        <span class="eyebrow">{pratique.eyebrow}</span>
        <h2>{pratique.title}</h2>
      </div>
      <div class="intro-text reveal reveal-delay-1">
        <p class="lead">
          <Lines text={pratique.text} />
        </p>
        <div class="intro-detail">
          <span>{pratique.detailLabel}</span>
          <p>
            <Lines text={pratique.detailText} />
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section formats" aria-labelledby="formats-title">
    <div class="container">
      <div class="formats-heading reveal">
        <span class="eyebrow">{formules.eyebrow}</span>
        <h2 id="formats-title">{formules.title}</h2>
      </div>
      <div class="formats-grid">
        {formules.items.map((format, index) => (
          <article class={`format-card reveal reveal-delay-${(index % 3) + 1}`}>
            <span class="format-index">
              {String(index + 1).padStart(2, '0')}
            </span>
            {format.marker && <span class="pill">{format.marker}</span>}
            <div>
              <h3>{format.name}</h3>
              {toParagraphs(format.text).map((paragraph) => (
                <p>
                  <Lines text={paragraph} />
                </p>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section flexibility">
    <div class="container flexibility-grid">
      <div class="flexibility-media reveal">
        <Image
          src={flexibility}
          alt={souplesse.imageAlt}
          widths={[520, 780, 1040]}
          sizes="(max-width: 832px) 100vw, 48vw"
          quality={86}
        />
        <span>{souplesse.imageCaption}</span>
      </div>
      <div class="flexibility-copy reveal reveal-delay-1">
        <span class="eyebrow">{souplesse.eyebrow}</span>
        <h2>{souplesse.title}</h2>
        <p class="lead">
          <Lines text={souplesse.text} />
        </p>
        <div class="flexibility-list">
          {souplesse.tags.map((tag) => (
            <span>{tag.text}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section safety">
    <div class="container safety-grid">
      <div class="safety-copy reveal">
        <span class="eyebrow">{cadre.eyebrow}</span>
        <h2>{cadre.title}</h2>
        <p>
          <Lines text={cadre.text} />
        </p>
        <a class="button" href="#planning">
          {cadre.buttonLabel}
          <span class="button__icon" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <div class="safety-media reveal reveal-delay-1">
        <Image
          src={flyKids}
          alt={cadre.imageAlt}
          widths={[480, 720]}
          sizes="(max-width: 832px) 100vw, 40vw"
          quality={85}
        />
        <div class="safety-badge">
          <strong>{cadre.badgeNumber}</strong>
          <span>{cadre.badgeText}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section prices" aria-labelledby="prices-title">
    <div class="container">
      <div class="prices-heading reveal">
        <span class="eyebrow">{tarifs.eyebrow}</span>
        <h2 id="prices-title">{tarifs.title}</h2>
      </div>
      <div class="prices-grid">
        <PricingList
          title={tarifs.collectiveTitle}
          items={collectiveItems}
          columns={[tarifs.collectiveColumn1, tarifs.collectiveColumn2]}
          note={tarifs.collectiveNote}
        />
        <PricingList
          title={tarifs.workshopsTitle}
          items={tarifs.workshopsItems}
          note={tarifs.workshopsNote}
          tone="cream"
        />
      </div>
    </div>
  </section>

  <section class="section collective-booking" id="planning">
    <div class="container reveal">
      <BookingEmbed
        id="planning-collectif"
        title={planning.title}
        description={planning.description}
        embedUrl={SITE.collectiveEmbed}
        profileUrl={content.commun.contact.bookingProfile}
        buttonLabel="Afficher le planning"
        tone="amber"
        autoLoad
        compact
      />
    </div>
  </section>

  <section class="section faq">
    <div class="narrow">
      <div class="faq-heading reveal">
        <span class="eyebrow">{faq.eyebrow}</span>
        <h2>{faq.title}</h2>
      </div>
      <div class="faq-list">
        {faq.items.map((item, index) => (
          <details class="reveal">
            <summary>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {item.question}
            </summary>
            {toParagraphs(item.answer).map((paragraph) => (
              <p>
                <Lines text={paragraph} />
              </p>
            ))}
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 8vw, 9rem);
    grid-template-columns: 1.1fr 0.9fr;
  }

  .intro-grid h2 {
    max-width: 10ch;
  }

  .intro-detail {
    display: grid;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(75 46 32 / 18%);
    gap: 1rem;
    grid-template-columns: 8rem 1fr;
  }

  .intro-detail span {
    color: var(--walnut);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .intro-detail p {
    margin: 0;
    color: var(--muted);
  }

  .formats {
    background: var(--harbor);
    color: var(--white);
  }

  .formats-heading {
    display: grid;
    align-items: end;
    margin-bottom: 5rem;
    gap: 2rem;
    grid-template-columns: 0.45fr 1fr;
  }

  .formats-heading h2 {
    max-width: 12ch;
    margin: 0;
  }

  .formats-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }

  .format-card {
    position: relative;
    display: grid;
    min-height: 22rem;
    align-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid rgb(255 255 255 / 15%);
    border-right: 1px solid rgb(255 255 255 / 15%);
    grid-column: span 4;
  }

  .format-card:nth-child(4),
  .format-card:nth-child(5),
  .format-card:nth-child(6) {
    grid-column: span 4;
  }

  .format-card:nth-child(3n) {
    border-right: 0;
  }

  .format-card .pill {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgb(255 255 255 / 10%);
    color: var(--white);
  }

  .format-index {
    color: var(--clay);
    font-size: 0.62rem;
    font-weight: 800;
  }

  .format-card h3 {
    margin-bottom: 1rem;
  }

  .format-card p {
    margin-bottom: 0;
    color: rgb(255 255 255 / 65%);
  }

  .format-card p + p {
    margin-top: 0.8rem;
  }

  .flexibility {
    background: var(--cream-deep);
  }

  .flexibility-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 1fr 0.85fr;
  }

  .flexibility-media {
    position: relative;
    min-height: 43rem;
    overflow: hidden;
    border-radius: 1.15rem;
  }

  .flexibility-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flexibility-media > span {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--cream);
    color: var(--walnut);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .flexibility-copy h2 {
    max-width: 9ch;
  }

  .flexibility-list {
    display: grid;
    margin-top: 2.5rem;
  }

  .flexibility-list span {
    padding: 1rem 0;
    border-top: 1px solid rgb(75 46 32 / 14%);
    font-size: 0.82rem;
    font-weight: 720;
  }

  .safety-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 0.8fr 1.2fr;
  }

  .safety-copy {
    padding-left: clamp(0rem, 5vw, 5rem);
  }

  .safety-copy h2 {
    max-width: 8ch;
  }

  .safety-copy p {
    margin-bottom: 2rem;
    color: var(--muted);
  }

  .safety-media {
    position: relative;
    min-height: 38rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--olive);
  }

  .safety-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .safety-badge {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    width: 11rem;
    min-height: 11rem;
    align-content: center;
    padding: 1.3rem;
    border-radius: 50%;
    background: var(--clay);
    color: var(--ink);
    text-align: center;
  }

  .safety-badge strong {
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.9;
  }

  .safety-badge span {
    margin-top: 0.5rem;
    font-size: 0.64rem;
    font-weight: 730;
    line-height: 1.35;
  }

  .prices {
    background: var(--sienna);
    color: var(--white);
  }

  .prices-heading {
    margin-bottom: 4rem;
  }

  .prices-heading h2 {
    max-width: 10ch;
  }

  .prices-grid {
    display: grid;
    color: var(--ink);
    gap: 1rem;
    grid-template-columns: 1.1fr 0.9fr;
  }

  .collective-booking {
    background: var(--cream-deep);
  }

  .faq-heading {
    margin-bottom: 3rem;
  }

  .faq-heading h2 {
    max-width: 11ch;
  }

  .faq-list {
    border-top: 1px solid rgb(75 46 32 / 18%);
  }

  details {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgb(75 46 32 / 18%);
  }

  summary {
    display: grid;
    align-items: baseline;
    color: var(--harbor);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    font-weight: 580;
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    color: var(--walnut);
    font-family: var(--font-body);
    font-size: 0.6rem;
  }

  details p {
    max-width: 42rem;
    margin: 1rem 0 0 3rem;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .intro-grid,
    .formats-heading,
    .flexibility-grid,
    .safety-grid,
    .prices-grid {
      grid-template-columns: 1fr;
    }

    .format-card,
    .format-card:nth-child(4),
    .format-card:nth-child(5),
    .format-card:nth-child(6) {
      min-height: 19rem;
      border-right: 0;
      grid-column: 1 / -1;
    }

    .flexibility-media,
    .safety-media {
      min-height: 32rem;
    }

    .safety-copy {
      padding-left: 0;
    }
  }
</style>
