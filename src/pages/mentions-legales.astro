---
import BaseLayout from '../layouts/BaseLayout.astro';
import Lines from '../components/Lines.astro';
import { toParagraphs } from '../cms/format';
import { getContent } from '../cms/load';

const { seo, hero, articles } = (await getContent()).mentions;
---

<BaseLayout title={seo.title} description={seo.description} noindex>
  <header class="legal-hero">
    <div class="narrow">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>
        <Lines text={hero.title} />
      </h1>
      <p>
        <Lines text={hero.intro} />
      </p>
    </div>
  </header>

  <section class="section">
    <div class="narrow legal-content">
      {articles.items.map((article, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2>{article.title}</h2>
            {toParagraphs(article.text).map((paragraph) => (
              <p>
                <Lines text={paragraph} linkify />
              </p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .legal-hero {
    padding: clamp(11rem, 18vw, 15rem) 0 clamp(5rem, 9vw, 8rem);
    background: var(--harbor);
    color: var(--white);
  }

  .legal-hero h1 {
    max-width: 9ch;
    margin-bottom: 2rem;
  }

  .legal-hero p {
    max-width: 42rem;
    margin: 0;
    color: var(--white);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
  }

  .legal-content {
    border-top: 1px solid rgb(75 46 32 / 16%);
  }

  article {
    display: grid;
    padding: clamp(2rem, 5vw, 4rem) 0;
    border-bottom: 1px solid rgb(75 46 32 / 16%);
    gap: 1.5rem;
    grid-template-columns: 3rem 1fr;
  }

  article > span {
    color: var(--walnut);
    font-size: 0.66rem;
    font-weight: 850;
  }

  article h2 {
    margin-bottom: 1.3rem;
    font-size: clamp(1.65rem, 3vw, 2.4rem);
  }

  article p {
    max-width: 48rem;
    color: var(--muted);
  }

  article :global(a) {
    margin-inline: 0.25rem;
    color: var(--walnut);
    font-weight: 700;
  }
</style>
