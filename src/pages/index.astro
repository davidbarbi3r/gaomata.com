---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandText from '../components/BrandText.astro';
import Lines from '../components/Lines.astro';
import Testimonial from '../components/Testimonial.astro';
import WorkshopCards from '../components/WorkshopCards.astro';
import flexibility from '../assets/images/souplesse.jpeg';
import heroImage from '../assets/images/souplesse-1.jpeg';
import { getContent, getWorkshops } from '../cms/load';
import { isUpcoming } from '../cms/workshops';
import { websiteSchema } from '../data/seo';

const content = await getContent();
const { seo, hero, choix, ateliers, methode, temoignages, lieux } =
  content.accueil;
const places = content.commun.lieux.items;
const upcoming = (await getWorkshops()).filter((workshop) =>
  isUpcoming(workshop),
);
const testimonialTones = ['clay', 'harbor', 'cream'] as const;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  schemas={[websiteSchema]}
>
  <section class="home-hero">
    <div class="hero-visual">
      <Image
        src={heroImage}
        alt={hero.imageAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        loading="eager"
        quality={100}
      />
      <div class="hero-copy">
        <div class="container hero-copy__grid">
          <div class="hero-title">
            <span class="eyebrow">
              <BrandText text={hero.eyebrow} />
            </span>
            <h1>
              <Lines text={hero.title} />
            </h1>
          </div>
          <div class="hero-intro">
            <p>
              <Lines text={hero.intro} />
            </p>
            <div class="cluster">
              <a class="button button--light" href="/reserver">
                {hero.ctaLabel}
                <span class="button__icon" aria-hidden="true">
                  ↗
                </span>
              </a>
              <a class="text-link" href="/a-propos">
                {hero.secondaryLabel}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section choices" aria-labelledby="choices-title">
    <div class="container">
      <div class="choices-intro reveal">
        <span class="eyebrow">{choix.eyebrow}</span>
        <h2 id="choices-title">{choix.title}</h2>
        <p class="lead">
          <Lines text={choix.intro} />
        </p>
      </div>

      <div class="choices-grid">
        <a class="choice choice--fly reveal" href="/fly-yoga-souplesse">
          <span class="choice-number">01</span>
          <div>
            <span class="choice-label">{choix.flyLabel}</span>
            <h3>{choix.flyTitle}</h3>
            <p>
              <Lines text={choix.flyText} />
            </p>
          </div>
          <span class="choice-arrow" aria-hidden="true">
            ↗
          </span>
        </a>

        <a
          class="choice choice--sophro reveal reveal-delay-1"
          href="/sophrologie-neuroatypie"
        >
          <span class="choice-number">02</span>
          <div>
            <span class="choice-label">{choix.sophroLabel}</span>
            <h3>{choix.sophroTitle}</h3>
            <p>
              <Lines text={choix.sophroText} />
            </p>
          </div>
          <span class="choice-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <WorkshopCards
      workshops={upcoming}
      eyebrow={ateliers.eyebrow}
      title={ateliers.title}
      intro={ateliers.intro}
      cardCta={ateliers.cardCta}
    />
  )}

  <section class="section method">
    <div class="container method-grid">
      <div class="method-copy reveal">
        <span class="eyebrow">
          <BrandText text={methode.eyebrow} />
        </span>
        <h2>{methode.title}</h2>
        <p class="lead">
          <Lines text={methode.text} />
        </p>
        <div class="method-points">
          {methode.points.map((point, index) => (
            <div>
              <strong>{String(index + 1).padStart(2, '0')}</strong>
              <span>{point.text}</span>
            </div>
          ))}
        </div>
        <a class="button button--light" href="/a-propos">
          {methode.buttonLabel}
          <span class="button__icon" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <div class="method-visual reveal reveal-delay-1">
        <Image
          src={flexibility}
          alt={methode.imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 832px) 100vw, 45vw"
          quality={85}
        />
        <span class="method-caption">{methode.caption}</span>
      </div>
    </div>
  </section>

  <section class="section testimonials" aria-labelledby="proof-title">
    <div class="container">
      <div class="proof-heading reveal">
        <span class="eyebrow">{temoignages.eyebrow}</span>
        <h2 id="proof-title">{temoignages.title}</h2>
      </div>
    </div>
    <div class="proof-marquee" data-marquee>
      <div class="proof-marquee__inner">
        <div class="proof-marquee__track">
          {temoignages.items.map((item, index) => (
            <Testimonial
              quote={item.quote}
              author={item.author}
              index={String(index + 1).padStart(2, '0')}
              tone={testimonialTones[index % testimonialTones.length]}
              compact
            />
          ))}
        </div>
        <div class="proof-marquee__track" aria-hidden="true">
          {temoignages.items.map((item, index) => (
            <Testimonial
              quote={item.quote}
              author={item.author}
              index={String(index + 1).padStart(2, '0')}
              tone={testimonialTones[index % testimonialTones.length]}
              compact
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section locations">
    <div class="container location-grid">
      <div class="location-heading reveal">
        <span class="eyebrow">{lieux.eyebrow}</span>
        <h2>{lieux.title}</h2>
      </div>
      <div class="location-list">
        {places.map((location, index) => (
          <article
            class={`location-row reveal reveal-delay-${(index % 3) + 1}`}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{location.city}</h3>
              <strong>{location.name}</strong>
              <p>
                <Lines text={location.detail} />
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    color: var(--ink);
  }

  .hero-visual {
    position: relative;
    width: 100%;
    min-height: min(100dvh, 58rem);
    height: clamp(40rem, 92dvh, 58rem);
    overflow: hidden;
    border-radius: 0 0 50% 50% / 0 0 5% 5%;
    background: var(--clay);
  }

  .hero-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  .hero-visual::after {
    position: absolute;
    inset: auto 0 0;
    height: 48%;
    background: linear-gradient(
      to top,
      rgb(30 22 16 / 42%) 0%,
      rgb(30 22 16 / 12%) 48%,
      transparent 100%
    );
    content: '';
    pointer-events: none;
  }

  .hero-copy {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    padding-block: 0 clamp(4.5rem, 9vw, 7rem);
  }

  .hero-copy__grid {
    display: grid;
    align-items: end;
    gap: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 6vw, 6rem);
    grid-template-columns: minmax(0, 1.05fr) minmax(17rem, 22rem);
  }

  .hero-title .eyebrow {
    margin-bottom: 1.35rem;
    color: var(--white);
  }

  .hero-title h1 {
    margin: 0;
    color: var(--white);
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    letter-spacing: -0.05em;
    line-height: 0.94;
    text-wrap: unset;
    text-shadow: 0 1rem 2.4rem rgb(30 22 16 / 28%);
  }

  .hero-intro {
    display: grid;
    gap: 1.75rem;
    padding-bottom: 0.2rem;
  }

  .hero-intro > p {
    max-width: 22rem;
    margin: 0;
    color: rgb(255 253 248 / 88%);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-intro .text-link {
    color: var(--white);
  }

  .choices-intro {
    display: grid;
    align-items: end;
    margin-bottom: clamp(3rem, 7vw, 6rem);
    gap: 2rem 5rem;
    grid-template-columns: 1.25fr 0.75fr;
  }

  .choices-intro .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: -0.8rem;
  }

  .choices-intro h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .choices-intro p {
    margin-bottom: 0.5rem;
  }

  .choices-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1.15fr 0.85fr;
  }

  .choice {
    position: relative;
    display: grid;
    min-height: 35rem;
    align-content: space-between;
    padding: clamp(1.7rem, 4vw, 3.5rem);
    overflow: hidden;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform 600ms var(--ease-out);
  }

  .choice:hover {
    transform: translateY(-0.5rem);
  }

  .choice--fly {
    background: var(--amber-deep);
    color: var(--white);
  }

  .choice--sophro {
    margin-top: 7rem;
    background: var(--olive);
    color: var(--white);
  }

  .choice::before {
    position: absolute;
    right: -12%;
    bottom: -25%;
    width: 24rem;
    height: 24rem;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 50%;
    box-shadow:
      0 0 0 3rem rgb(255 255 255 / 4%),
      0 0 0 7rem rgb(255 255 255 / 3%);
    content: '';
  }

  .choice-number,
  .choice-label {
    font-size: 0.62rem;
    font-weight: 780;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .choice-number {
    opacity: 1;
  }

  .choice-label {
    display: block;
    margin-bottom: 1.1rem;
  }

  .choice h3 {
    max-width: 12ch;
    margin-bottom: 1.2rem;
    font-size: clamp(1.7rem, 3.2vw, 2.55rem);
  }

  .choice p {
    max-width: 37rem;
    margin-bottom: 0;
    color: var(--white);
  }

  .choice-arrow {
    position: absolute;
    top: 2rem;
    right: 2rem;
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 50%;
    transition: transform 500ms var(--ease-out);
  }

  .choice:hover .choice-arrow {
    transform: translate(0.2rem, -0.2rem) rotate(8deg);
  }

  .method {
    background: var(--harbor);
    color: var(--white);
  }

  .method-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
  }

  .method-copy h2 {
    max-width: 11ch;
  }

  .method-copy .lead {
    color: rgb(255 255 255 / 68%);
  }

  .method-points {
    display: grid;
    margin: 3rem 0;
  }

  .method-points div {
    display: grid;
    padding: 1rem 0;
    border-top: 1px solid rgb(255 255 255 / 13%);
    gap: 1rem;
    grid-template-columns: 2rem 1fr;
  }

  .method-points strong {
    color: var(--clay);
    font-size: 0.65rem;
  }

  .method-points span {
    font-weight: 650;
  }

  .method-visual {
    position: relative;
    min-height: 41rem;
    overflow: hidden;
    border-radius: 1.15rem;
  }

  .method-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .method-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0.9rem 1.2rem;
    background: rgb(30 47 68 / 82%);
    color: var(--white);
    font-size: 0.65rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
  }

  .proof-heading {
    display: grid;
    align-items: end;
    margin-bottom: 4rem;
    gap: 2rem;
    grid-template-columns: 0.4fr 1fr;
  }

  .proof-heading h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .proof-marquee {
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 6%,
      black 94%,
      transparent
    );
  }

  .proof-marquee__inner {
    display: flex;
    width: max-content;
    gap: 1rem;
    animation: proof-scroll 48s linear infinite;
  }

  .proof-marquee:hover .proof-marquee__inner,
  .proof-marquee:focus-within .proof-marquee__inner {
    animation-play-state: paused;
  }

  .proof-marquee__track {
    display: flex;
    gap: 1rem;
  }

  @keyframes proof-scroll {
    to {
      transform: translateX(calc(-50% - 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-marquee {
      mask-image: none;
    }

    .proof-marquee__inner {
      animation: none !important;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
      padding-inline: 1rem;
    }

    .proof-marquee__track[aria-hidden] {
      display: none;
    }
  }

  .locations {
    background: var(--cream-deep);
  }

  .location-grid {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 0.9fr 1.1fr;
  }

  .location-heading {
    position: sticky;
    top: 8rem;
    align-self: start;
  }

  .location-heading h2 {
    max-width: 10ch;
  }

  .location-list {
    display: grid;
  }

  .location-row {
    display: grid;
    padding: 2.5rem 0;
    border-top: 1px solid rgb(75 46 32 / 15%);
    gap: 1.5rem;
    grid-template-columns: 2rem 1fr;
  }

  .location-row > span {
    color: var(--walnut);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .location-row h3 {
    margin-bottom: 0.7rem;
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
  }

  .location-row strong {
    display: block;
    color: var(--harbor);
    font-size: 0.82rem;
  }

  .location-row p {
    max-width: 34rem;
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .method-grid,
    .location-grid {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .hero-copy {
      padding-block: 0 4.5rem;
    }

    .hero-copy__grid {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .hero-title h1 {
      font-size: clamp(2.25rem, 8.5vw, 3.1rem);
    }

    .hero-intro > p {
      max-width: 28rem;
    }

    .hero-visual {
      min-height: 36rem;
      height: clamp(36rem, 92dvh, 46rem);
      border-radius: 0 0 50% 50% / 0 0 4% 4%;
    }

    .choices-intro,
    .choices-grid,
    .proof-heading {
      grid-template-columns: 1fr;
    }

    .choice--sophro {
      margin-top: 0;
    }

    .choice {
      min-height: 30rem;
    }

    .method-visual {
      min-height: 34rem;
      grid-row: 1;
    }

    .location-heading {
      position: static;
    }
  }
</style>
