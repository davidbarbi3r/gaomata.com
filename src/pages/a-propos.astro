---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandText from '../components/BrandText.astro';
import Lines from '../components/Lines.astro';
import PageHero from '../components/PageHero.astro';
import portrait from '../assets/images/marion-portrait.jpeg';
import duo from '../assets/images/marion-edwige.jpeg';
import eventOne from '../assets/images/fly-evenement-1.jpeg';
import eventTwo from '../assets/images/fly-evenement-3.jpeg';
import { getContent } from '../cms/load';
import { breadcrumbSchema } from '../data/seo';
import { SITE } from '../data/site';

const content = await getContent();
const { seo, hero, histoire, parcours, manifeste, partenariats, evenements } =
  content.aPropos;
const { contact } = content.commun;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      '@id': `${SITE.url}/a-propos#marion-aubreton`,
      name: SITE.owner,
      jobTitle: 'Fondatrice de Gao Mata',
      worksFor: { '@id': `${SITE.url}/#business` },
      knowsAbout: ['Fly Yoga', 'Souplesse', 'Sophrologie', 'Neuroatypie'],
    },
  },
  breadcrumbSchema([
    { name: 'Accueil', path: '/' },
    { name: 'À propos', path: '/a-propos' },
  ]),
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  type="profile"
  {schemas}
>
  <PageHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    intro={hero.intro}
    image={portrait}
    alt={hero.imageAlt}
    tone="harbor"
  >
    <a class="button button--light" href="/reserver">
      {hero.ctaLabel}
      <span class="button__icon" aria-hidden="true">
        ↗
      </span>
    </a>
  </PageHero>

  <section class="section story">
    <div class="container story-grid">
      <span class="story-year reveal">{histoire.year}</span>
      <div class="story-copy reveal reveal-delay-1">
        <span class="eyebrow">{histoire.eyebrow}</span>
        <h2>{histoire.title}</h2>
        <p class="lead">
          <Lines text={histoire.text} />
        </p>
        <p>
          <Lines text={histoire.extra} />
        </p>
      </div>
    </div>
  </section>

  <section class="section timeline">
    <div class="container timeline-grid">
      <div class="timeline-image reveal">
        <Image
          src={duo}
          alt={parcours.imageAlt}
          widths={[540, 810, 1080]}
          sizes="(max-width: 832px) 100vw, 47vw"
          quality={86}
        />
        <span>{parcours.imageCaption}</span>
      </div>
      <div class="timeline-content">
        {parcours.steps.map((step, index) => (
          <div
            class={`timeline-item reveal${index ? ` reveal-delay-${Math.min(index, 3)}` : ''}`}
          >
            <span>{step.year}</span>
            <div>
              <h2>{step.title}</h2>
              <p>
                <Lines text={step.text} />
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="manifesto">
    <div class="container">
      <p class="reveal">
        «&nbsp;
        <Lines text={manifeste.quote} />
        &nbsp;»
      </p>
      <p class="manifesto-wish reveal reveal-delay-1">
        <Lines text={manifeste.wish} />
      </p>
      <span class="reveal reveal-delay-1">
        <BrandText text={manifeste.signature} />
      </span>
    </div>
  </section>

  <section class="section partnerships" aria-labelledby="partners-title">
    <div class="container">
      <div class="partners-heading reveal">
        <span class="eyebrow">{partenariats.eyebrow}</span>
        <h2 id="partners-title">{partenariats.title}</h2>
      </div>
      <div class="partners-layout">
        <div class="partners-images">
          <div class="partner-image partner-image--large reveal">
            <Image
              src={eventOne}
              alt={partenariats.imageAlt1}
              widths={[480, 720, 960]}
              sizes="(max-width: 832px) 100vw, 40vw"
              quality={85}
            />
          </div>
          <div class="partner-image partner-image--small reveal reveal-delay-1">
            <Image
              src={eventTwo}
              alt={partenariats.imageAlt2}
              widths={[320, 560]}
              sizes="(max-width: 832px) 72vw, 22vw"
              quality={85}
            />
          </div>
        </div>
        <div class="partners-list">
          {partenariats.items.map((partner, index) => (
            <article class={`reveal reveal-delay-${(index % 3) + 1}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{partner.title}</h3>
                <p>
                  <Lines text={partner.text} />
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section events-cta">
    <div class="narrow reveal">
      <span class="eyebrow">{evenements.eyebrow}</span>
      <h2>{evenements.title}</h2>
      <p class="lead">
        <Lines text={evenements.text} />
      </p>
      <a
        class="button"
        href={`mailto:${contact.email}?subject=Projet%20ou%20événement%20Gao%20Mata`}
      >
        {evenements.buttonLabel}
        <span class="button__icon" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 8vw, 9rem);
    grid-template-columns: 0.45fr 1fr;
  }

  .story-year {
    color: var(--sienna);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .story-copy h2 {
    max-width: 10ch;
  }

  .story-copy > p:last-child {
    max-width: 40rem;
    margin-top: 2rem;
    color: var(--muted);
  }

  .timeline {
    background: var(--clay);
  }

  .timeline-grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: 0.9fr 1.1fr;
  }

  .timeline-image {
    position: relative;
    min-height: 44rem;
    overflow: hidden;
    border-radius: 1.15rem;
  }

  .timeline-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline-image > span {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    padding: 0.8rem;
    border-radius: var(--radius-pill);
    background: rgb(75 46 32 / 70%);
    color: var(--white);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .timeline-content {
    display: grid;
  }

  .timeline-item {
    display: grid;
    padding: 3rem 0;
    border-top: 1px solid rgb(75 46 32 / 23%);
    gap: 2rem;
    grid-template-columns: 4rem 1fr;
  }

  .timeline-item > span {
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 850;
  }

  .timeline-item h2 {
    max-width: 11ch;
    margin-bottom: 1.2rem;
    color: var(--ink);
    font-size: clamp(1.7rem, 3.2vw, 2.5rem);
  }

  .timeline-item p {
    margin: 0;
    color: var(--ink);
  }

  .manifesto {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: var(--harbor);
    color: var(--white);
    text-align: center;
  }

  .manifesto p {
    max-width: 16ch;
    margin: 0 auto 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.15rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .manifesto p.manifesto-wish {
    max-width: 36rem;
    margin: 0 auto 2.5rem;
    color: rgb(255 255 255 / 78%);
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.7;
  }

  .manifesto span {
    display: block;
    color: var(--clay);
    font-size: 0.65rem;
    font-weight: 780;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .manifesto .brand-name {
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .partners-heading {
    display: grid;
    align-items: end;
    margin-bottom: 5rem;
    gap: 2rem;
    grid-template-columns: 0.4fr 1fr;
  }

  .partners-heading h2 {
    max-width: 12ch;
    margin: 0;
  }

  .partners-layout {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
    grid-template-columns: 0.85fr 1.15fr;
  }

  .partners-images {
    position: sticky;
    top: 8rem;
    display: grid;
    align-items: end;
    gap: 1rem;
    grid-template-columns: 1.15fr 0.85fr;
  }

  .partner-image {
    position: relative;
    overflow: hidden;
    border-radius: 1.15rem;
  }

  .partner-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .partner-image--large {
    min-height: 36rem;
  }

  .partner-image--small {
    min-height: 24rem;
  }

  .partners-list {
    display: grid;
  }

  .partners-list article {
    display: grid;
    padding: 2rem 0;
    border-top: 1px solid rgb(75 46 32 / 16%);
    gap: 1.5rem;
    grid-template-columns: 2rem 1fr;
  }

  .partners-list article > span {
    color: var(--walnut);
    font-size: 0.62rem;
    font-weight: 850;
  }

  .partners-list h3 {
    margin-bottom: 0.65rem;
  }

  .partners-list p {
    margin: 0;
    color: var(--muted);
  }

  .events-cta {
    background: var(--cream-deep);
    text-align: center;
  }

  .events-cta h2,
  .events-cta p {
    margin-inline: auto;
  }

  .events-cta h2 {
    max-width: 14ch;
  }

  .events-cta .lead {
    margin-bottom: 2rem;
  }

  @media (max-width: 52rem) {
    .story-grid,
    .timeline-grid,
    .partners-heading,
    .partners-layout {
      grid-template-columns: 1fr;
    }

    .story-year {
      font-size: clamp(2.2rem, 8vw, 2.8rem);
    }

    .timeline-image {
      min-height: 34rem;
    }

    .partners-images {
      position: relative;
      top: auto;
      grid-template-columns: 1fr 0.85fr;
    }

    .partner-image--large,
    .partner-image--small {
      min-height: 22rem;
    }
  }
</style>
