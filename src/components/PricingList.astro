---
interface PriceItem {
  label: string;
  price: string;
  note?: string;
}

interface Props {
  title: string;
  items: PriceItem[];
  note?: string;
  tone?: 'paper' | 'cream';
}

const { title, items, note, tone = 'paper' } = Astro.props;
---

<section class={`pricing pricing--${tone}`}>
  <div class="pricing__head">
    <h3>{title}</h3>
    {note && <p>{note}</p>}
  </div>
  <div class="pricing__items">
    {items.map((item) => (
      <div class="pricing__row">
        <div>
          <strong>{item.label}</strong>
          {item.note && <small>{item.note}</small>}
        </div>
        <span>{item.price}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .pricing {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .pricing--paper {
    background: var(--paper);
  }

  .pricing--cream {
    background: var(--cream-deep);
  }

  .pricing__head {
    padding: clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(75 46 32 / 11%);
  }

  .pricing__head h3 {
    margin-bottom: 0.5rem;
  }

  .pricing__head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .pricing__items {
    display: grid;
  }

  .pricing__row {
    display: grid;
    align-items: baseline;
    padding: 1.15rem clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(75 46 32 / 9%);
    gap: 1rem;
    grid-template-columns: 1fr auto;
  }

  .pricing__row:last-child {
    border-bottom: 0;
  }

  .pricing__row strong,
  .pricing__row small {
    display: block;
  }

  .pricing__row strong {
    font-size: 0.86rem;
  }

  .pricing__row small {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .pricing__row > span {
    color: var(--harbor);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 620;
  }
</style>
