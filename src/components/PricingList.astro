---
interface PriceItem {
  label: string;
  price: string | readonly string[];
  note?: string;
}

interface Props {
  title: string;
  items: PriceItem[];
  note?: string;
  columns?: string[];
  tone?: 'paper' | 'cream';
}

const { title, items, note, columns = [], tone = 'paper' } = Astro.props;
const priceColumns = Math.max(columns.length, 1);
---

<section class={`pricing pricing--${tone}`}>
  <div class="pricing__head">
    <h3>{title}</h3>
    {note && <p>{note}</p>}
  </div>
  <div class="pricing__items" style={`--price-columns: ${priceColumns}`}>
    {columns.length > 0 && (
      <div class="pricing__row pricing__row--columns" aria-hidden="true">
        <span></span>
        {columns.map((column) => (
          <span>{column}</span>
        ))}
      </div>
    )}
    {items.map((item) => (
      <div class="pricing__row">
        <div>
          <strong>{item.label}</strong>
          {item.note && <small>{item.note}</small>}
        </div>
        {typeof item.price === 'string' ? (
          <span class="pricing__price pricing__price--span">{item.price}</span>
        ) : (
          item.price.map((price, index) => (
            <span class="pricing__price">
              {price}
              {columns[index] && <span class="sr-only"> {columns[index]}</span>}
            </span>
          ))
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .pricing {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .pricing--paper {
    background: var(--paper);
  }

  .pricing--cream {
    background: var(--cream-deep);
  }

  .pricing__head {
    padding: clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(75 46 32 / 11%);
  }

  .pricing__head h3 {
    margin-bottom: 0.5rem;
  }

  .pricing__head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .pricing__items {
    display: grid;
  }

  .pricing__row {
    display: grid;
    align-items: baseline;
    padding: 1.15rem clamp(1.6rem, 4vw, 3rem);
    border-bottom: 1px solid rgb(75 46 32 / 9%);
    gap: 1rem;
    grid-template-columns: 1fr repeat(var(--price-columns), auto);
  }

  .pricing__row--columns {
    padding-block: 0.9rem 0.4rem;
    border-bottom: 0;
  }

  .pricing__row--columns > span {
    color: var(--muted);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: uppercase;
  }

  .pricing__row:last-child {
    border-bottom: 0;
  }

  .pricing__row strong,
  .pricing__row small {
    display: block;
  }

  .pricing__row strong {
    font-size: 0.86rem;
  }

  .pricing__row small {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .pricing__price {
    color: var(--harbor);
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 620;
  }

  .pricing__price--span {
    grid-column: 2 / -1;
  }
</style>
