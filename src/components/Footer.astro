---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logo-gaomata-blanc.png';
import logoGreen from '../assets/brand/logo-gaomata-vert.png';
import { getContent } from '../cms/load';
import { phoneHref } from '../cms/format';
import { SITE } from '../data/site';

const { footer, contact } = (await getContent()).commun;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-cta reveal">
      <Image
        class="footer-cta__mark"
        src={logoWhite}
        alt=""
        width={112}
        height={112}
        densities={[2]}
        format="png"
        quality={100}
      />
      <div>
        <span class="eyebrow">{footer.ctaEyebrow}</span>
        <h2>{footer.ctaTitle}</h2>
      </div>
      <a class="button button--light" href="/reserver">
        {footer.ctaButton}
        <span class="button__icon" aria-hidden="true">
          ↗
        </span>
      </a>
    </div>

    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" aria-label={`${SITE.name}, accueil`}>
          <Image
            src={logoGreen}
            alt=""
            width={56}
            height={56}
            densities={[2, 3]}
            format="png"
            quality={100}
          />
          <span>{SITE.name}</span>
        </a>
        <p>{footer.tagline}</p>
      </div>

      <div class="footer-group">
        <strong>{footer.exploreTitle}</strong>
        <a href="/fly-yoga-souplesse">{footer.linkFly}</a>
        <a href="/sophrologie-neuroatypie">{footer.linkSophro}</a>
        <a href="/a-propos">{footer.linkAbout}</a>
        <a href="/reserver">{footer.linkBooking}</a>
      </div>

      <div class="footer-group">
        <strong>{footer.visitTitle}</strong>
        {footer.visitPlaces.map((place) => (
          <span>{place.text}</span>
        ))}
        <a href={phoneHref(contact.phone)}>{contact.phone}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>
        © {year} {SITE.name}
      </span>
      <span>{footer.bottomTagline}</span>
      <a href="/mentions-legales">{footer.legalLink}</a>
    </div>
    <div class="footer-credit">
      <a class="footer-admin" href="/admin" rel="nofollow">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <rect x="3" y="7" width="10" height="7" rx="1.5"></rect>
          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"></path>
        </svg>
        {footer.adminLink}
      </a>
      <p>
        développé par{' '}
        <a href="https://www.davidbarbier.com" rel="noopener noreferrer">
          David
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 0.6rem 0 1.5rem;
    background: var(--cream);
  }

  .footer-cta {
    position: relative;
    display: grid;
    min-height: 25rem;
    align-items: end;
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 78% 10%,
        rgb(208 138 82 / 42%),
        transparent 27%
      ),
      var(--sienna);
    box-shadow: var(--shadow-deep);
    color: var(--white);
    gap: 2rem;
    grid-template-columns: 1fr auto;
  }

  .footer-cta__mark {
    position: absolute;
    top: clamp(1.5rem, 4vw, 3rem);
    right: clamp(1.5rem, 4vw, 3rem);
    width: clamp(4.5rem, 9vw, 7rem);
    height: auto;
    opacity: 0.62;
  }

  .footer-cta h2 {
    max-width: 12ch;
    margin-bottom: 0;
  }

  .footer-main {
    display: grid;
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-bottom: 1px solid rgb(75 46 32 / 15%);
    gap: 3rem;
    grid-template-columns: 1.7fr 0.8fr 0.8fr;
  }

  .footer-brand > a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--harbor);
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    font-weight: 570;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
  }

  .footer-brand > a :global(img) {
    width: 3.2rem;
    height: 3.2rem;
    object-fit: contain;
  }

  .footer-brand p {
    max-width: 30rem;
    margin: 1.4rem 0 0;
    color: var(--muted);
  }

  .footer-group {
    display: grid;
    align-content: start;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-group strong {
    margin-bottom: 0.6rem;
    color: var(--walnut);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-group a {
    width: fit-content;
    text-decoration: none;
  }

  .footer-group a:hover {
    color: var(--sienna);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.7rem 2rem;
    padding-top: 1.4rem;
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
  }

  .footer-bottom a {
    color: var(--walnut);
  }

  .footer-credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.56rem;
    gap: 0.7rem;
    letter-spacing: 0.04em;
  }

  .footer-credit p {
    margin: 0;
  }

  .footer-credit .footer-admin {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(75 46 32 / 18%);
    border-radius: var(--radius-pill);
    font-size: 0.6rem;
    font-weight: 700;
    gap: 0.35rem;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }

  .footer-admin svg {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.4;
  }

  .footer-credit .footer-admin:hover {
    border-color: var(--walnut);
  }

  .footer-credit p a {
    margin-inline-start: 0.35em;
    color: inherit;
    text-decoration: none;
  }

  .footer-credit p a:hover {
    color: var(--walnut);
  }

  @media (max-width: 50rem) {
    .footer-cta {
      min-height: 30rem;
      align-content: end;
      grid-template-columns: 1fr;
    }

    .footer-cta .button {
      width: fit-content;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .footer-main {
      grid-template-columns: 1fr;
    }
  }
</style>
