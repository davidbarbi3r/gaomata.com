---
import { Image } from 'astro:assets';
import logoGreen from '../assets/brand/logo-gaomata-vert.png';
import { SITE } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/fly-yoga-souplesse', label: 'Fly & Souplesse' },
  { href: '/sophrologie-neuroatypie', label: 'Sophrologie' },
  { href: '/a-propos', label: 'À propos' },
];
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — Accueil`}>
      <span class="brand-mark" aria-hidden="true">
        <Image
          src={logoGreen}
          alt=""
          width={48}
          height={48}
          densities={[2, 3]}
          format="png"
          quality={100}
          loading="eager"
        />
      </span>
      <span>
        <strong>{SITE.name}</strong>
        <small>Corps · Souffle · Singularité</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a class="header-cta" href="/reserver">
      Réserver
      <span aria-hidden="true">↗</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Navigation mobile">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/reserver">Réserver une séance</a>
    </nav>
    <div class="menu-meta">
      <span>Boisseuil · Limoges</span>
      <a href="mailto:gao.mata87@gmail.com">gao.mata87@gmail.com</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('[data-mobile-menu]');

  const closeMenu = () => {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', 'Ouvrir le menu');
    menu.hidden = true;
    document.body.classList.remove('menu-open');
  };

  button?.addEventListener('click', () => {
    if (!menu) return;
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    button.setAttribute(
      'aria-label',
      open ? 'Ouvrir le menu' : 'Fermer le menu',
    );
    menu.hidden = open;
    document.body.classList.toggle('menu-open', !open);
  });

  menu
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 20;
    top: 1rem;
    right: 0;
    left: 0;
    width: min(calc(100% - 2rem), 76rem);
    margin-inline: auto;
    border: 1px solid rgb(255 255 255 / 36%);
    border-radius: 1.2rem;
    background: rgb(246 240 229 / 97%);
    box-shadow: 0 12px 40px rgb(75 46 32 / 10%);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 4.8rem;
    align-items: center;
    padding: 0.55rem 0.7rem 0.55rem 1rem;
    grid-template-columns: 1fr auto auto;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.75rem;
    color: var(--harbor);
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: 2.9rem;
    height: 2.9rem;
  }

  .brand-mark :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.035em;
    line-height: 1;
  }

  .brand small {
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    padding-inline: 1rem;
  }

  .desktop-nav a {
    position: relative;
    padding: 0.65rem 0.75rem;
    color: var(--walnut);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0.75rem;
    bottom: 0.38rem;
    left: 0.75rem;
    height: 1px;
    background: var(--sienna);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 400ms var(--ease-out);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-cta {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.65rem 0.55rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--sienna);
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
  }

  .header-cta span {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 14%);
    transition: transform 400ms var(--ease-out);
  }

  .header-cta:hover span {
    transform: translate(0.12rem, -0.12rem);
  }

  .menu-toggle {
    display: none;
  }

  .mobile-menu {
    padding: 2rem 1.2rem 1.25rem;
    border-top: 1px solid rgb(75 46 32 / 10%);
  }

  .mobile-menu nav {
    display: grid;
  }

  .mobile-menu nav a {
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(75 46 32 / 10%);
    color: var(--harbor);
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.25;
    text-decoration: none;
  }

  .menu-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 1.5rem;
    color: var(--muted);
    font-size: 0.7rem;
  }

  @media (max-width: 59rem) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
    }

    .menu-toggle {
      position: relative;
      display: grid;
      width: 3.2rem;
      height: 3.2rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--harbor);
      cursor: pointer;
      place-items: center;
    }

    .menu-toggle span {
      position: absolute;
      width: 1rem;
      height: 1px;
      background: var(--white);
      transition: transform 500ms var(--ease-out);
    }

    .menu-toggle span:first-child {
      transform: translateY(-0.22rem);
    }

    .menu-toggle span:last-child {
      transform: translateY(0.22rem);
    }

    .menu-toggle[aria-expanded='true'] span:first-child {
      transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] span:last-child {
      transform: rotate(-45deg);
    }
  }

  @media (max-width: 28rem) {
    .brand small {
      display: none;
    }
  }
</style>
